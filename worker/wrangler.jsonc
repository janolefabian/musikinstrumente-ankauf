{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "musikinstrument-ankauf-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  "vars": {
    "ALLOWED_ORIGIN": "https://musikinstrument-ankauf.de",
    "OPENAI_MODEL": "gpt-5-mini",
    "REVIEW_BASE_URL": "https://musikinstrument-ankauf.de",
  },

  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "musikinstrument-ankauf-photos",
    },
  ],

  "d1_databases": [
    {
      "binding": "LEADS",
      "database_name": "musikinstrument-ankauf-leads",
      "database_id": "36171733-d97d-466c-aab2-60b2788b09bc",
    },
  ],
}
