{
  "name": "musikinstrument-ankauf-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --no-warnings --test src/*.test.js",
    "check": "WRANGLER_LOG_PATH=.wrangler/logs/check.log wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:init": "npm run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply LEADS --local",
    "db:migrate:remote": "wrangler d1 migrations apply LEADS --remote",
    "thumbnails:backfill": "node ./scripts/backfill-thumbnails.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.28.0"
  }
}
