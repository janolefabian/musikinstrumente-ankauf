---
import BaseLayout from '../layouts/BaseLayout.astro';
import CityContent from '../components/CityContent.astro';
import { cities } from '../data/cities';

export function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}
const { city } = Astro.props;
---
<BaseLayout
  title={city.seoTitle || `Instrument in ${city.name} verkaufen – Fotos senden`}
  description={city.seoDescription || `Musikinstrument aus ${city.name} online anbieten: Fotos senden, Anfrage zwischenspeichern und persönlich prüfen lassen. Ohne Fachkenntnisse.`}
  canonical={`/${city.slug}/`}
>
  <CityContent city={city} />
</BaseLayout>
