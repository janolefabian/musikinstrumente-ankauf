---
import { cities } from '../data/cities';
---
<section class="section city-section" aria-labelledby="city-title">
  <div class="section-inner">
    <p class="eyebrow">In Ihrer Region</p>
    <h2 id="city-title">Deutschlandweit online erreichbar.</h2>
    <p class="section-lead">Der erste Schritt findet per Foto statt. Die Regional-Seiten erklären, wie die Anfrage aus Ihrer Stadt abläuft; alles Weitere wird persönlich und passend zum Instrument abgestimmt.</p>
    <div class="city-links">
      {cities.map((city) => (
        <a href={`/${city.slug}/`}>Instrument verkaufen in {city.name}</a>
      ))}
    </div>
  </div>
</section>
